{
  "name": "pdfzin",
  "private": true,
  "version": "1.0.0",
  "description": "PDFZIN — leitor e editor de PDF open source que roda 100% no navegador.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pdf", "pdf-editor", "pdf-reader", "pdf.js", "pdf-lib", "privacy"],
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
